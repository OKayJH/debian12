[Unit]
Description=X11vnc server for okay user
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/x11vnc -display :0 -forever -shared -repeat -noxdamage -noxkb -noxrecord -noxfixes -rfbauth /home/okay/.vnc/passwd
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0

[Install]
WantedBy=graphical-session.target
